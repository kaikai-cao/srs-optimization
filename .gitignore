/target
/node_modules

/data/fixtures/*
!/data/fixtures/.gitkeep

/results/raw/*
!/results/raw/.gitkeep
# M3 text-only measurement records are small and reproducible: keep them in git.
!/results/raw/m3_*.json

/results/processed/*
!/results/processed/.gitkeep
!/results/processed/m3_*.csv
!/results/processed/m3_*.svg
!/results/processed/m3_*.json
!/results/processed/m3_*.md

# M4 committed artifacts: repeat-baseline summaries only (raw timelines stay local).
!/results/processed/m4_*.csv
!/results/processed/m4_*.md

# M5 committed artifacts: probe perturbation summary only (JSONL / timelines stay local).
!/results/processed/m5*.csv
!/results/processed/m5*.md

# results/processed/M2-public-dataset/ (+ .zip) stay local: they contain binary
# parameter files and are covered by /results/processed/* above.

*.ptau
*.bin
*.zkey
*.wtns
